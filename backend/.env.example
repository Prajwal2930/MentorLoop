# Server configuration
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins. Required when NODE_ENV=production.
CLIENT_URL=http://localhost:5173

# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017/mentorloop

# Authentication configuration
JWT_SECRET=<any>
JWT_EXPIRES_IN=7d

# Google Gemini configuration
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises GitHub REST API rate limits for repository reviews
GITHUB_TOKEN=replace_with_a_github_personal_access_token
